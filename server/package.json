{
  "name": "adp-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "ADP NestJS backend",
  "scripts": {
    "build": "sh -c 'if [ \"${ADP_BUILD_MODE:-local}\" = \"docker\" ]; then npm run build:docker; else npm run build:local; fi'",
    "build:local": "nest build -p tsconfig.build.json",
    "build:docker": "nest build -p tsconfig.build.docker.json",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist-local/main.js",
    "prompts-chain:example": "node --env-file=src/config/.env --loader ts-node/esm src/prompts-chain/example/example.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.1.27",
    "@langchain/openai": "^1.2.9",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "joi": "^17.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.5",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
